Testing DEFINITIONS AUTOMATIC TAGS ::= BEGIN

-- The one ASN.1 file of the oracle tests in lib/per.
--
-- pycrate 0.8.1 and Erlang/OTP 29.1.1 both read this text. The generators in this directory
-- ask them for the PER octets of every row, and testing.py writes testing.json. No script
-- writes ASN.1, and every type in this file compiles in both oracles.
--
-- Names. A type is named <Prefix>-<name>. The prefix is the kind of the vectors: Unsigned,
-- Namedbits, Strings, Fragments, Regression, Iri, Oid, Reloid, Additions, Composites, Pdvs
-- and Times. The six oldest kinds keep one name for each constraint shape: BOOLEAN-PLAIN,
-- INTEGER-..., ENUM-..., FLOAT-64, OCTETSTRING-... and BITSTRING-.... A comment in a section
-- writes a type without its prefix. The class of Pdvs is PDVS-TYPE-ID, because a class name
-- is in upper case. BOOLEAN-PLAIN is not called BOOL, because the generated code of pycrate
-- has a class BOOL of its own.
--
-- Spelling. A type has the spelling that both oracles accept: INTEGER for INTEGER (MIN..MAX),
-- VisibleString for ISO646String (the same type), and a SEQUENCE in place of a type with two
-- parameters in Times.
--
-- Types that only one oracle answers are in two other files: testing_otp.asn1 (module
-- TestingOtp, for OTP: INSTANCE OF TYPE-IDENTIFIER, which pycrate cannot compile) and
-- testing_pycrate.asn1 (module TestingPycrate, for pycrate: a FROM with the extension marker,
-- a FROM of one character, and a FROM set above U+007F, which OTP cannot read).

-- BOOLEAN (kind bool)

BOOLEAN-PLAIN ::= BOOLEAN

-- INTEGER with a range, semi-constrained and extensible (kind integer)

-- unconstrained
INTEGER-NULL-NULL-FALSE ::= INTEGER

-- semi-constrained (lower bound only), not extensible
INTEGER-0-NULL-FALSE    ::= INTEGER (0..MAX)
INTEGER-10-NULL-FALSE   ::= INTEGER (10..MAX)
INTEGER-20-NULL-FALSE   ::= INTEGER (20..MAX)
INTEGER-100-NULL-FALSE  ::= INTEGER (100..MAX)
