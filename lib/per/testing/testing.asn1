-- SEQUENCE, SET, CHOICE, SEQUENCE OF, SET OF (kind composites)

-- SEQUENCE with OPTIONAL and DEFAULT components (X.691 19.2, 19.5).
Composites-Opt ::= SEQUENCE {
    a BOOLEAN OPTIONAL,
    b INTEGER (0..255) DEFAULT 7,
    c IA5String (SIZE (1..8)) OPTIONAL,
    d BOOLEAN DEFAULT TRUE,
    e INTEGER (0..255)
}

-- The same bits as Opt with b and d sent, even when equal to their DEFAULT.
Composites-OptSent ::= SEQUENCE {
    a BOOLEAN OPTIONAL,
    b INTEGER (0..255) OPTIONAL,
    c IA5String (SIZE (1..8)) OPTIONAL,
    d BOOLEAN OPTIONAL,
    e INTEGER (0..255)
}

Composites-Empty ::= SEQUENCE {}

Composites-EmptyExt ::= SEQUENCE {
    ...
}

-- Version 1 and version 2 of an extensible SEQUENCE (X.691 19.1, 19.6 to 19.9).
Composites-Ext1 ::= SEQUENCE {
    a BOOLEAN,
    b INTEGER (0..255) OPTIONAL,
    ...,
    c INTEGER (0..255) OPTIONAL
}

-- An addition whose inner encoding is empty: NULL gives the open type 00 (X.691 11.1.3, 11.2).
Composites-ExtN ::= SEQUENCE {
    a BOOLEAN,
    ...,
    n NULL OPTIONAL
}

-- A root component after the second extension marker is encoded before the
-- additions (X.691 19.9 note 2).
Composites-ExtT1 ::= SEQUENCE {
    a BOOLEAN,
    b INTEGER (0..255) OPTIONAL,
    ...,
    c INTEGER (0..255) OPTIONAL,
    ...,
    t INTEGER (0..255)
}

Composites-Ext2 ::= SEQUENCE {
    a BOOLEAN,
    b INTEGER (0..255) OPTIONAL,
    ...,
    c INTEGER (0..255) OPTIONAL,
    d IA5String (SIZE (1..8)) OPTIONAL,
    g BOOLEAN OPTIONAL,
    [[
        e BOOLEAN,
        f INTEGER (0..255) OPTIONAL
    ]]
}

-- SET (X.691 21): Set1 has context tags in textual order, Set2 sorts to c, b, e, a, d.
Composites-Set1 ::= SET {
    a BOOLEAN,
    b INTEGER (0..255) OPTIONAL,
    c IA5String (SIZE (1..8))
}

Composites-Set2 ::= SET {
    a [2] BOOLEAN,
    b [0] INTEGER (0..255),
    c [APPLICATION 1] IA5String (SIZE (1..8)),
    d [PRIVATE 0] BOOLEAN OPTIONAL,
    e [1] BOOLEAN DEFAULT FALSE
}

-- The same components as Set1 and Set2, declared as a SEQUENCE in the sorted order of
-- X.691 21 (same tags). Their encodings are the expected ones of the SET types.
Composites-Set1Seq ::= SEQUENCE {
    a BOOLEAN,
    b INTEGER (0..255) OPTIONAL,
    c IA5String (SIZE (1..8))
}

Composites-Set2Seq ::= SEQUENCE {
    c [APPLICATION 1] IA5String (SIZE (1..8)),
    b [0] INTEGER (0..255),
    e [1] BOOLEAN DEFAULT FALSE,
    a [2] BOOLEAN,
    d [PRIVATE 0] BOOLEAN OPTIONAL
}

-- CHOICE (X.691 23).
Composites-Ch1 ::= CHOICE {
    a INTEGER (0..255)
}

Composites-Ch2 ::= CHOICE {
    a BOOLEAN,
    b INTEGER (0..255)
}

Composites-Ch3 ::= CHOICE {
    a BOOLEAN,
    b INTEGER (0..255),
    c IA5String (SIZE (1..8))
}

Composites-Ch5 ::= CHOICE {
    a BOOLEAN,
    b INTEGER (0..255),
    c IA5String (SIZE (1..8)),
    d BOOLEAN,
    e INTEGER (0..255)
}

Composites-ChExt1 ::= CHOICE {
    a BOOLEAN,
    b INTEGER (0..255),
    ...,
    c IA5String (SIZE (1..8))
}

Composites-ChExt2 ::= CHOICE {
    a BOOLEAN,
    b INTEGER (0..255),
    ...,
    c IA5String (SIZE (1..8)),
    d BOOLEAN,
    e INTEGER (0..255)
}

-- SEQUENCE OF and SET OF (X.691 20, 22).
Composites-SeqNo   ::= SEQUENCE OF INTEGER (0..255)
Composites-Seq3    ::= SEQUENCE (SIZE (3)) OF INTEGER (0..255)
Composites-Seq10   ::= SEQUENCE (SIZE (0..10)) OF INTEGER (0..255)
Composites-SeqExt  ::= SEQUENCE (SIZE (1..5, ...)) OF INTEGER (0..255)
Composites-Seq70k  ::= SEQUENCE (SIZE (0..70000)) OF INTEGER (0..255)
Composites-SeqBool ::= SEQUENCE OF BOOLEAN
Composites-SetNo   ::= SET OF INTEGER (0..255)
Composites-SetExt  ::= SET (SIZE (1..5, ...)) OF INTEGER (0..255)

-- EMBEDDED PDV, EXTERNAL, CHARACTER STRING (kind pdvs)

-- Oracle types of Phase 8: EMBEDDED PDV (X.691 28), EXTERNAL (29), CHARACTER STRING (31).
-- Pdv, Ext and Cs are the built-in types. PdvSeq, ExtSeq and CsSeq are the types that
-- the clauses name; the vectors take their answers where a built-in type of an oracle
-- does not follow the clause (generator pdvs.py states where).

-- The CLASS TYPE-IDENTIFIER of X.681 Annex A, written out so that both oracles read
-- the same text.
PDVS-TYPE-ID ::= CLASS {
    &id OBJECT IDENTIFIER UNIQUE,
    &Type
} WITH SYNTAX {&Type IDENTIFIED BY &id}

-- The identification of X.680 36.5, 37.5 and 44.5.
Pdvs-Ident ::= CHOICE {
    syntaxes SEQUENCE {
        abstract OBJECT IDENTIFIER,
        transfer OBJECT IDENTIFIER
    },
    syntax OBJECT IDENTIFIER,
    presentation-context-id INTEGER,
    context-negotiation SEQUENCE {
        presentation-context-id INTEGER,
        transfer-syntax OBJECT IDENTIFIER
    },
    transfer-syntax OBJECT IDENTIFIER,
    fixed NULL
}

Pdvs-Pdv ::= EMBEDDED PDV

-- X.691 28.3: the type of X.680 36.5 without data-value-descriptor, so without a
-- preamble.
Pdvs-PdvSeq ::= SEQUENCE {
    identification Pdvs-Ident,
    data-value OCTET STRING
}

Pdvs-Cs ::= CHARACTER STRING

-- X.691 31.3: the type of X.680 44.5 without data-value-descriptor.
Pdvs-CsSeq ::= SEQUENCE {
    identification Pdvs-Ident,
    string-value OCTET STRING
}

Pdvs-Ext ::= EXTERNAL

-- X.691 29.1.
Pdvs-ExtSeq ::= [UNIVERSAL 8] IMPLICIT SEQUENCE {
    direct-reference OBJECT IDENTIFIER OPTIONAL,
    indirect-reference INTEGER OPTIONAL,
    data-value-descriptor ObjectDescriptor OPTIONAL,
    encoding CHOICE {
        single-ASN1-type [0] PDVS-TYPE-ID.&Type,
        octet-aligned [1] IMPLICIT OCTET STRING,
        arbitrary [2] IMPLICIT BIT STRING
    }
}

-- X.681 C.7: the associated type of INSTANCE OF, EXPLICIT tags.
Pdvs-InstSeq ::= SEQUENCE {
    type-id PDVS-TYPE-ID.&id,
    value [0] EXPLICIT PDVS-TYPE-ID.&Type
}

-- X.691 28.2 and 31.2: with the identification fixed to one alternative, only the data
-- value is sent, as an OCTET STRING.
Pdvs-PdvFixed   ::= EMBEDDED PDV (WITH COMPONENTS {..., identification (WITH COMPONENTS {..., fixed PRESENT})})
Pdvs-PdvSyntax  ::= EMBEDDED PDV (WITH COMPONENTS {..., identification (WITH COMPONENTS {..., syntax PRESENT})})
Pdvs-CsFixed    ::= CHARACTER STRING (WITH COMPONENTS {..., identification (WITH COMPONENTS {..., fixed PRESENT})})
Pdvs-Predefined ::= OCTET STRING

-- A small type whose complete encoding is the payload of a single-ASN1-type or of
-- an INSTANCE OF value (X.691 11.2).
Pdvs-Small ::= SEQUENCE {
    a BOOLEAN,
    b INTEGER (0..255)
}

-- Time types (kind times)

-- Oracle types of Phase 9: the time types of X.680 38 and their PER encoding, X.691 32.
-- Neither oracle encodes the time types themselves, so each one is asked for the type that
-- X.691 32.1.2 names (shall be encoded as if the type ... had been replaced by the type
-- specified in ... column 3 of Table 2), and the unconstrained TIME for the MIXED-ENCODING of
-- 32.11. Lines from the 32.2 header down to the last encoding type are the text of
-- specs/builtin.asn1 (clause 32 of X.691), copied here.
-- The probe types are at the end of the module.
-- Three spellings differ from the text of the clause, and each one is the same type (OTP
-- stops, or never ends, on the clause spelling): INTEGER for INTEGER with the range MIN to MAX;
-- INTEGER for the remainder of YEAR-ENCODING (the range MIN to 1748 or 2277 to MAX has the
-- bounds MIN and MAX, so X.691 13.2.4 applies: no bound restricts the value); and SEQUENCE of date and time for
-- DATE-TIME-ENCODING with two parameters inside the interval types of the rows 36, 40, 43, 46,
-- 50 and 53.
--
-- Revisions:
--   - 2026-10-19 15:43: initial creation

-- 32.2: encoding subtypes with the Basic=Date property setting (14 types).

Times-CENTURY-ENCODING ::= INTEGER (0..99) -- 7 bits
-- first two digits of the year component

Times-ANY-CENTURY-ENCODING ::= INTEGER
-- year component, ignoring the last two digits

Times-YEAR-ENCODING ::= CHOICE { -- 2 bits for choice determinant
    immediate   INTEGER (2005..2020), -- 4 bits
    near-future INTEGER (2021..2276), -- 8 bits
    near-past   INTEGER (1749..2004), -- 8 bits
    remainder   INTEGER
}
-- optimized to provide a 6-bit or 10-bit encoding in common cases

Times-ANY-YEAR-ENCODING ::= INTEGER

Times-YEAR-MONTH-ENCODING ::= SEQUENCE {
    year  Times-YEAR-ENCODING,
    month INTEGER (1..12) -- 4 bits
}
-- optimized to provide a 10-bit or 14-bit encoding in common cases

Times-ANY-YEAR-MONTH-ENCODING ::= SEQUENCE {
    year  Times-ANY-YEAR-ENCODING,
    month INTEGER (1..12)
}

Times-DATE-ENCODING ::= SEQUENCE {
    year  Times-YEAR-ENCODING,
    month INTEGER (1..12), -- 4 bits
    day   INTEGER (1..31)  -- 5 bits
}
-- optimized to provide a 15-bit or 19-bit encoding in common cases

Times-ANY-DATE-ENCODING ::= SEQUENCE {
    year  Times-ANY-YEAR-ENCODING,
    month INTEGER (1..12),
    day   INTEGER (1..31)
}

Times-YEAR-DAY-ENCODING ::= SEQUENCE {
    year Times-YEAR-ENCODING,
    day  INTEGER (1..366)
}

Times-ANY-YEAR-DAY-ENCODING ::= SEQUENCE {
    year Times-ANY-YEAR-ENCODING,
    day  INTEGER (1..366)
}

Times-YEAR-WEEK-ENCODING ::= SEQUENCE {
    year Times-YEAR-ENCODING,
    week INTEGER (1..53) -- 6 bits
}
-- optimized to provide a 12-bit or 16-bit encoding in common cases

Times-ANY-YEAR-WEEK-ENCODING ::= SEQUENCE {
    year Times-ANY-YEAR-ENCODING,
    week INTEGER (1..53)
}

Times-YEAR-WEEK-DAY-ENCODING ::= SEQUENCE {
    year Times-YEAR-ENCODING,
    week INTEGER (1..53), -- 6 bits
    day  INTEGER (1..7)   -- 3 bits
}
-- optimized to provide a 15-bit or 19-bit encoding in common cases

Times-ANY-YEAR-WEEK-DAY-ENCODING ::= SEQUENCE {
    year Times-ANY-YEAR-ENCODING,
    week INTEGER (1..53),
    day  INTEGER (1..7)
}

-- 32.3: encoding subtypes with the Basic=Time property setting (18 types).
-- TIME-DIFFERENCE is a shared helper used by every -AND-DIFF variant below.

Times-TIME-DIFFERENCE ::= SEQUENCE {
    sign    ENUMERATED { positive, negative },
    hours   INTEGER (0..15),
    minutes INTEGER (1..59) OPTIONAL -- omitted if zero
}

Times-HOURS-ENCODING ::= INTEGER (0..24) -- 5 bits

Times-HOURS-UTC-ENCODING ::= INTEGER (0..24) -- 5 bits

Times-HOURS-AND-DIFF-ENCODING ::= SEQUENCE {
    local-hours     INTEGER (0..24),
    time-difference Times-TIME-DIFFERENCE
}

Times-MINUTES-ENCODING ::= SEQUENCE {
    hours   INTEGER (0..24), -- 5 bits
    minutes INTEGER (0..59)  -- 5 bits
}
-- optimized to provide a 10-bit encoding

Times-MINUTES-UTC-ENCODING ::= SEQUENCE {
    hours   INTEGER (0..24), -- 5 bits
    minutes INTEGER (0..59)  -- 5 bits
}
-- optimized to provide a 10-bit encoding

Times-MINUTES-AND-DIFF-ENCODING ::= SEQUENCE {
    local-time SEQUENCE {
        hours   INTEGER (0..24),
        minutes INTEGER (0..59)
    },
    time-difference Times-TIME-DIFFERENCE
}

Times-TIME-OF-DAY-ENCODING ::= SEQUENCE {
    hours   INTEGER (0..24), -- 5 bits
    minutes INTEGER (0..59), -- 5 bits
    seconds INTEGER (0..60)  -- 5 bits
}
-- optimized to provide a 15-bit encoding

Times-TIME-OF-DAY-UTC-ENCODING ::= SEQUENCE {
    hours   INTEGER (0..24), -- 5 bits
    minutes INTEGER (0..59), -- 5 bits
    seconds INTEGER (0..60)  -- 5 bits
}
-- optimized to provide a 15-bit encoding

Times-TIME-OF-DAY-AND-DIFF-ENCODING ::= SEQUENCE {
    local-time SEQUENCE {
        hours   INTEGER (0..24),
        minutes INTEGER (0..59),
        seconds INTEGER (0..60)
    },
    time-difference Times-TIME-DIFFERENCE
}

Times-HOURS-AND-FRACTION-ENCODING ::= SEQUENCE {
    hours    INTEGER (0..24), -- 5 bits
    fraction INTEGER (0..999, ..., 1000..MAX) -- 11 bits for up to 3-digit accuracy
}
-- optimized to provide a 16-bit encoding for up to 3-digit accuracy

Times-HOURS-UTC-AND-FRACTION-ENCODING ::= SEQUENCE {
    hours    INTEGER (0..24), -- 5 bits
    fraction INTEGER (0..999, ..., 1000..MAX) -- 11 bits for up to 3-digit accuracy
}
-- optimized to provide a 16-bit encoding for up to 3-digit accuracy

Times-HOURS-AND-DIFF-AND-FRACTION-ENCODING ::= SEQUENCE {
    local-hours     INTEGER (0..24), -- 5 bits
    fraction        INTEGER (0..999, ..., 1000..MAX), -- 11 bits for up to 3-digit accuracy
    time-difference Times-TIME-DIFFERENCE
}

Times-MINUTES-AND-FRACTION-ENCODING ::= SEQUENCE {
    hours    INTEGER (0..24), -- 5 bits
    minutes  INTEGER (0..59), -- 5 bits
    fraction INTEGER (0..999, ..., 1000..MAX) -- 11 bits for up to 3-digit accuracy
}
-- optimized to provide a 21-bit encoding for up to 3-digit accuracy

Times-MINUTES-UTC-AND-FRACTION-ENCODING ::= SEQUENCE {
    hours    INTEGER (0..24), -- 5 bits
    minutes  INTEGER (0..59), -- 5 bits
    fraction INTEGER (0..999, ..., 1000..MAX) -- 11 bits for up to 3-digit accuracy
}
-- optimized to provide a 21-bit encoding for up to 3-digit accuracy

Times-MINUTES-AND-DIFF-AND-FRACTION-ENCODING ::= SEQUENCE {
    local-time SEQUENCE {
        hours    INTEGER (0..24),
        minutes  INTEGER (0..59),
        fraction INTEGER (0..999, ..., 1000..MAX)
    },
    time-difference Times-TIME-DIFFERENCE
}

Times-TIME-OF-DAY-AND-FRACTION-ENCODING ::= SEQUENCE {
    hours    INTEGER (0..24), -- 5 bits
    minutes  INTEGER (0..59), -- 5 bits
    seconds  INTEGER (0..60), -- 5 bits
    fraction INTEGER (0..999, ..., 1000..MAX) -- 11 bits for up to 3-digit accuracy
}
-- optimized to provide a 26-bit encoding

Times-TIME-OF-DAY-UTC-AND-FRACTION-ENCODING ::= SEQUENCE {
    hours    INTEGER (0..24), -- 5 bits
    minutes  INTEGER (0..59), -- 5 bits
    seconds  INTEGER (0..60), -- 5 bits
    fraction INTEGER (0..999, ..., 1000..MAX) -- 11 bits for up to 3-digit accuracy
}
-- optimized to provide a 26-bit encoding

Times-TIME-OF-DAY-AND-DIFF-AND-FRACTION-ENCODING ::= SEQUENCE {
    local-time SEQUENCE {
        hours    INTEGER (0..24),
        minutes  INTEGER (0..59),
        seconds  INTEGER (0..60),
        fraction INTEGER (0..999, ..., 1000..MAX)
    },
    time-difference Times-TIME-DIFFERENCE
}

-- 32.4: encoding subtypes with the Basic=Date-Time property setting.
-- Date-Type/Time-Type are instantiated with the row-specific types from
-- 32.2/32.3 that match the abstract value's actual property settings.

Times-DATE-TIME-ENCODING {Date-Type, Time-Type} ::= SEQUENCE {
    date Date-Type,
    time Time-Type
}
-- optimized to provide a 32-bit encoding in common cases

-- 32.5: encoding subtypes with the Basic=Interval Interval-type=SE
-- property setting (start/end interval).

Times-START-END-DATE-INTERVAL-ENCODING {Date-Type} ::= SEQUENCE {
    start Date-Type,
    end   Date-Type
}

Times-START-END-TIME-INTERVAL-ENCODING {Time-Type} ::= SEQUENCE {
    start Time-Type,
    end   Time-Type
}

Times-START-END-DATE-TIME-INTERVAL-ENCODING {Date-Type, Time-Type} ::= SEQUENCE {
    start SEQUENCE { date Date-Type, time Time-Type },
    end   SEQUENCE { date Date-Type, time Time-Type }
}

-- 32.6: encoding subtypes with the Basic=Interval Interval-type=D property
-- setting (duration). The weeks component is present iff years/months/days/
-- hours/minutes/seconds are all absent; a zero-valued time element is
-- present only if it is the least-significant one, or has a fractional
-- part, keeping the encoding canonical.

Times-DURATION-INTERVAL-ENCODING ::= SEQUENCE { -- 8 bits for optionality
    years   INTEGER (0..31, ..., 32..MAX) OPTIONAL, -- 5 bits for up to 31 years
    months  INTEGER (0..15, ..., 16..MAX) OPTIONAL, -- 4 bits for up to 15 months
    weeks   INTEGER (0..63, ..., 64..MAX) OPTIONAL, -- 6 bits for up to 63 weeks
    days    INTEGER (0..31, ..., 32..MAX) OPTIONAL, -- 5 bits for up to 31 days
    hours   INTEGER (0..31, ..., 32..MAX) OPTIONAL, -- 5 bits for up to 31 hours
    minutes INTEGER (0..63, ..., 64..MAX) OPTIONAL, -- 6 bits for up to 63 minutes
    seconds INTEGER (0..63, ..., 64..MAX) OPTIONAL, -- 6 bits for up to 63 seconds
    fractional-part SEQUENCE {
        number-of-digits INTEGER (1..3, ..., 4..MAX),  -- 3 bits for up to 3-digit accuracy
        fractional-value INTEGER (0..999, ..., 1000..MAX) -- 11 bits for up to 3-digit accuracy
    } OPTIONAL
}

-- 32.7: encoding subtypes with the Basic=Interval Interval-type=SD or
-- Basic=Interval Interval-type=DE property setting (start+duration, or
-- duration+end).

Times-START-DATE-DURATION-INTERVAL-ENCODING {Date-Type} ::= SEQUENCE {
    start    Date-Type,
    duration Times-DURATION-INTERVAL-ENCODING
}

Times-START-TIME-DURATION-INTERVAL-ENCODING {Time-Type} ::= SEQUENCE {
    start    Time-Type,
    duration Times-DURATION-INTERVAL-ENCODING
}

Times-START-DATE-TIME-DURATION-INTERVAL-ENCODING {Date-Type, Time-Type} ::= SEQUENCE {
    start    SEQUENCE { date Date-Type, time Time-Type },
    duration Times-DURATION-INTERVAL-ENCODING
}

Times-DURATION-END-DATE-INTERVAL-ENCODING {Date-Type} ::= SEQUENCE {
    duration Times-DURATION-INTERVAL-ENCODING,
    end      Date-Type
}

Times-DURATION-END-TIME-INTERVAL-ENCODING {Time-Type} ::= SEQUENCE {
    duration Times-DURATION-INTERVAL-ENCODING,
    end      Time-Type
}

Times-DURATION-END-DATE-TIME-INTERVAL-ENCODING {Date-Type, Time-Type} ::= SEQUENCE {
    duration Times-DURATION-INTERVAL-ENCODING,
    end      SEQUENCE { date Date-Type, time Time-Type }
}

-- 32.8: encoding subtypes with the Basic=Rec-Interval Interval-type=SE
-- property setting (recurring start/end interval). recurrence is absent
-- for an unlimited number of recurrences, else the recurrence count.

Times-REC-START-END-DATE-INTERVAL-ENCODING {Date-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    start      Date-Type,
    end        Date-Type
}

Times-REC-START-END-TIME-INTERVAL-ENCODING {Time-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    start      Time-Type,
    end        Time-Type
}

Times-REC-START-END-DATE-TIME-INTERVAL-ENCODING {Date-Type, Time-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    start      SEQUENCE { date Date-Type, time Time-Type },
    end        SEQUENCE { date Date-Type, time Time-Type }
}

-- 32.9: encoding subtypes with the Basic=Rec-Interval Interval-type=D
-- property setting (recurring duration).

Times-REC-DURATION-INTERVAL-ENCODING ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    duration   Times-DURATION-INTERVAL-ENCODING
}

-- 32.10: encoding subtypes with the Basic=Rec-Interval Interval-type=SD
-- or Basic=Rec-Interval Interval-type=DE property setting (recurring
-- start+duration, or duration+end).

Times-REC-START-DATE-DURATION-INTERVAL-ENCODING {Date-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    start      Date-Type,
    duration   Times-DURATION-INTERVAL-ENCODING
}

Times-REC-START-TIME-DURATION-INTERVAL-ENCODING {Time-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    start      Time-Type,
    duration   Times-DURATION-INTERVAL-ENCODING
}

Times-REC-START-DATE-TIME-DURATION-INTERVAL-ENCODING {Date-Type, Time-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    start      SEQUENCE { date Date-Type, time Time-Type },
    duration   Times-DURATION-INTERVAL-ENCODING
}

Times-REC-DURATION-END-DATE-INTERVAL-ENCODING {Date-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    duration   Times-DURATION-INTERVAL-ENCODING,
    end        Date-Type
}

Times-REC-DURATION-END-TIME-INTERVAL-ENCODING {Time-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    duration   Times-DURATION-INTERVAL-ENCODING,
    end        Time-Type
}

Times-REC-DURATION-END-DATE-TIME-INTERVAL-ENCODING {Date-Type, Time-Type} ::= SEQUENCE {
    recurrence INTEGER OPTIONAL,
    duration   Times-DURATION-INTERVAL-ENCODING,
    end        SEQUENCE { date Date-Type, time Time-Type }
}

-- 32.11: encoding subtypes with mixed settings of the Basic property (the
-- unconstrained TIME type, or any subset spanning more than one row of
-- Table 2). DATE-TYPE/TIME-TYPE select the row-specific date/time-of-day
-- encoding that matches the abstract value's actual property settings;
-- MIXED-ENCODING is the top-level type used whenever a TIME value doesn't
-- fall entirely within one single row of Table 2.

Times-FRACTIONAL-TIME {Time-Type} ::= SEQUENCE {
    number-of-digits INTEGER (1..MAX),
    time-value       Time-Type
}

Times-DATE-TYPE ::= CHOICE {
    row-1  Times-CENTURY-ENCODING,
    row-2  Times-ANY-CENTURY-ENCODING,
    row-3  Times-YEAR-ENCODING,
    row-4  Times-ANY-YEAR-ENCODING,
    row-5  Times-YEAR-MONTH-ENCODING,
    row-6  Times-ANY-YEAR-MONTH-ENCODING,
    row-7  Times-DATE-ENCODING,
    row-8  Times-ANY-DATE-ENCODING,
    row-9  Times-YEAR-DAY-ENCODING,
    row-10 Times-ANY-YEAR-DAY-ENCODING,
    row-11 Times-YEAR-WEEK-ENCODING,
    row-12 Times-ANY-YEAR-WEEK-ENCODING,
    row-13 Times-YEAR-WEEK-DAY-ENCODING,
    row-14 Times-ANY-YEAR-WEEK-DAY-ENCODING
}

Times-TIME-TYPE ::= SEQUENCE {
    number-of-digits INTEGER (1..MAX) OPTIONAL, -- present iff time-type is row-24..row-32
    time-type CHOICE {
        row-15 Times-HOURS-ENCODING,
        row-16 Times-HOURS-UTC-ENCODING,
        row-17 Times-HOURS-AND-DIFF-ENCODING,
        row-18 Times-MINUTES-ENCODING,
        row-19 Times-MINUTES-UTC-ENCODING,
        row-20 Times-MINUTES-AND-DIFF-ENCODING,
        row-21 Times-TIME-OF-DAY-ENCODING,
        row-22 Times-TIME-OF-DAY-UTC-ENCODING,
        row-23 Times-TIME-OF-DAY-AND-DIFF-ENCODING,
        row-24 Times-HOURS-AND-FRACTION-ENCODING,
        row-25 Times-HOURS-UTC-AND-FRACTION-ENCODING,
        row-26 Times-HOURS-AND-DIFF-AND-FRACTION-ENCODING,
        row-27 Times-MINUTES-AND-FRACTION-ENCODING,
        row-28 Times-MINUTES-UTC-AND-FRACTION-ENCODING,
        row-29 Times-MINUTES-AND-DIFF-AND-FRACTION-ENCODING,
        row-30 Times-TIME-OF-DAY-AND-FRACTION-ENCODING,
        row-31 Times-TIME-OF-DAY-UTC-AND-FRACTION-ENCODING,
        row-32 Times-TIME-OF-DAY-AND-DIFF-AND-FRACTION-ENCODING
    }
}

Times-MIXED-ENCODING ::= CHOICE {
    row-1  Times-CENTURY-ENCODING,
    row-2  Times-ANY-CENTURY-ENCODING,
    row-3  Times-YEAR-ENCODING,
    row-4  Times-ANY-YEAR-ENCODING,
    row-5  Times-YEAR-MONTH-ENCODING,
    row-6  Times-ANY-YEAR-MONTH-ENCODING,
    row-7  Times-DATE-ENCODING,
    row-8  Times-ANY-DATE-ENCODING,
    row-9  Times-YEAR-DAY-ENCODING,
    row-10 Times-ANY-YEAR-DAY-ENCODING,
    row-11 Times-YEAR-WEEK-ENCODING,
    row-12 Times-ANY-YEAR-WEEK-ENCODING,
    row-13 Times-YEAR-WEEK-DAY-ENCODING,
    row-14 Times-ANY-YEAR-WEEK-DAY-ENCODING,
    row-15 Times-HOURS-ENCODING,
    row-16 Times-HOURS-UTC-ENCODING,
    row-17 Times-HOURS-AND-DIFF-ENCODING,
    row-18 Times-MINUTES-ENCODING,
    row-19 Times-MINUTES-UTC-ENCODING,
    row-20 Times-MINUTES-AND-DIFF-ENCODING,
    row-21 Times-TIME-OF-DAY-ENCODING,
    row-22 Times-TIME-OF-DAY-UTC-ENCODING,
    row-23 Times-TIME-OF-DAY-AND-DIFF-ENCODING,
    row-24 Times-FRACTIONAL-TIME {Times-HOURS-AND-FRACTION-ENCODING},
    row-25 Times-FRACTIONAL-TIME {Times-HOURS-UTC-AND-FRACTION-ENCODING},
    row-26 Times-FRACTIONAL-TIME {Times-HOURS-AND-DIFF-AND-FRACTION-ENCODING},
    row-27 Times-FRACTIONAL-TIME {Times-MINUTES-AND-FRACTION-ENCODING},
    row-28 Times-FRACTIONAL-TIME {Times-MINUTES-UTC-AND-FRACTION-ENCODING},
    row-29 Times-FRACTIONAL-TIME {Times-MINUTES-AND-DIFF-AND-FRACTION-ENCODING},
    row-30 Times-FRACTIONAL-TIME {Times-TIME-OF-DAY-AND-FRACTION-ENCODING},
    row-31 Times-FRACTIONAL-TIME {Times-TIME-OF-DAY-UTC-AND-FRACTION-ENCODING},
    row-32 Times-FRACTIONAL-TIME {Times-TIME-OF-DAY-AND-DIFF-AND-FRACTION-ENCODING},
    row-33 Times-DATE-TIME-ENCODING {Times-DATE-TYPE, Times-TIME-TYPE},
    row-34 Times-START-END-DATE-INTERVAL-ENCODING {Times-DATE-TYPE},
    row-35 Times-START-END-TIME-INTERVAL-ENCODING {Times-TIME-TYPE},
    row-36 Times-START-END-DATE-TIME-INTERVAL-ENCODING {Times-DATE-TYPE, Times-TIME-TYPE},
    row-37 Times-DURATION-INTERVAL-ENCODING,
    row-38 Times-START-DATE-DURATION-INTERVAL-ENCODING {Times-DATE-TYPE},
    row-39 Times-START-TIME-DURATION-INTERVAL-ENCODING {Times-TIME-TYPE},
    row-40 Times-START-DATE-TIME-DURATION-INTERVAL-ENCODING {Times-DATE-TYPE, Times-TIME-TYPE},
    row-41 Times-DURATION-END-DATE-INTERVAL-ENCODING {Times-DATE-TYPE},
    row-42 Times-DURATION-END-TIME-INTERVAL-ENCODING {Times-TIME-TYPE},
    row-43 Times-DURATION-END-DATE-TIME-INTERVAL-ENCODING {Times-DATE-TYPE, Times-TIME-TYPE},
    row-44 Times-REC-START-END-DATE-INTERVAL-ENCODING {Times-DATE-TYPE},
    row-45 Times-REC-START-END-TIME-INTERVAL-ENCODING {Times-TIME-TYPE},
    row-46 Times-REC-START-END-DATE-TIME-INTERVAL-ENCODING {Times-DATE-TYPE, Times-TIME-TYPE},
    row-47 Times-REC-DURATION-INTERVAL-ENCODING,
    row-48 Times-REC-START-DATE-DURATION-INTERVAL-ENCODING {Times-DATE-TYPE},
    row-49 Times-REC-START-TIME-DURATION-INTERVAL-ENCODING {Times-TIME-TYPE},
    row-50 Times-REC-START-DATE-TIME-DURATION-INTERVAL-ENCODING {Times-DATE-TYPE, Times-TIME-TYPE},
    row-51 Times-REC-DURATION-END-DATE-INTERVAL-ENCODING {Times-DATE-TYPE},
    row-52 Times-REC-DURATION-END-TIME-INTERVAL-ENCODING {Times-TIME-TYPE},
    row-53 Times-REC-DURATION-END-DATE-TIME-INTERVAL-ENCODING {Times-DATE-TYPE, Times-TIME-TYPE}
}


-- Probe types. Each one is a row of Table 2 with its parameters instantiated as the clause says.

-- Row 7, DATE (X.680 38.4.1: Date=YMD Year=Basic).
Times-DateProbe ::= Times-DATE-ENCODING

-- Row 21, TIME-OF-DAY (X.680 38.4.2: Time=HMS Local-or-UTC=L).
Times-TimeOfDayProbe ::= Times-TIME-OF-DAY-ENCODING

-- Row 33 with rows 7 and 21, DATE-TIME (X.680 38.4.3; X.691 32.4.2).
Times-DateTimeProbe ::= Times-DATE-TIME-ENCODING {Times-DATE-ENCODING, Times-TIME-OF-DAY-ENCODING}

-- Row 37, DURATION (X.680 38.4.4).
Times-DurationProbe ::= Times-DURATION-INTERVAL-ENCODING

-- The unconstrained TIME (X.691 32.1.4 note 2): the MIXED-ENCODING of 32.11.5.
Times-MixedProbe ::= Times-MIXED-ENCODING

-- The parts of the MIXED-ENCODING, asked alone: the date types, the time types, the
-- fractional time, the YEAR-ENCODING.
Times-DateTypeProbe      ::= Times-DATE-TYPE
Times-TimeTypeProbe      ::= Times-TIME-TYPE
Times-YearProbe          ::= Times-YEAR-ENCODING
Times-AnyDateProbe       ::= Times-ANY-DATE-ENCODING
Times-TimeDiffProbe      ::= Times-TIME-DIFFERENCE
Times-TodUtcProbe        ::= Times-TIME-OF-DAY-UTC-ENCODING
Times-TodDiffProbe       ::= Times-TIME-OF-DAY-AND-DIFF-ENCODING
Times-TodFracUtcProbe    ::= Times-TIME-OF-DAY-UTC-AND-FRACTION-ENCODING
Times-TodFracDiffProbe   ::= Times-TIME-OF-DAY-AND-DIFF-AND-FRACTION-ENCODING
Times-DateTimeMixedProbe ::= Times-DATE-TIME-ENCODING {Times-DATE-TYPE, Times-TIME-TYPE}


-- NumericString after k BOOLEAN bits (k = 0 to 7), so the characters start at every bit
-- offset. U: no SIZE; F-n: SIZE (n); R-n: SIZE (0..n+7). Read by testing/numeric_offset.py.

Numoff-0-U      ::= NumericString
Numoff-0-F-0    ::= NumericString (SIZE (0))
Numoff-0-F-1    ::= NumericString (SIZE (1))
Numoff-0-F-2    ::= NumericString (SIZE (2))
Numoff-0-F-3    ::= NumericString (SIZE (3))
Numoff-0-F-4    ::= NumericString (SIZE (4))
Numoff-0-F-7    ::= NumericString (SIZE (7))
Numoff-0-F-8    ::= NumericString (SIZE (8))
Numoff-0-F-15   ::= NumericString (SIZE (15))
Numoff-0-F-16   ::= NumericString (SIZE (16))
Numoff-0-F-17   ::= NumericString (SIZE (17))
Numoff-0-F-31   ::= NumericString (SIZE (31))
Numoff-0-F-32   ::= NumericString (SIZE (32))
Numoff-0-F-33   ::= NumericString (SIZE (33))
Numoff-0-F-47   ::= NumericString (SIZE (47))
Numoff-0-F-48   ::= NumericString (SIZE (48))
Numoff-0-F-63   ::= NumericString (SIZE (63))
Numoff-0-F-64   ::= NumericString (SIZE (64))
