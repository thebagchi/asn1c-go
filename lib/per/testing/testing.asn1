-- IRI (kind iri)

-- Neither oracle compiles OID-IRI and RELATIVE-OID-IRI as a type. X.691 clauses
-- 26 and 27 encode each as the UTF-8 contents octets behind an unconstrained
-- length (X.690 8.21, 8.22), which is what a UTF8String holds (X.691 30.5).
Iri-Text ::= UTF8String

-- OBJECT IDENTIFIER (kind oid)

Oid-Oid ::= OBJECT IDENTIFIER

-- RELATIVE-OID (kind relativeoid)

Reloid-Rel ::= RELATIVE-OID

-- Extension additions, X.691 19.7 (kind additions)

-- 70 extension additions: the bitmap of X.691 19.7 has more than 64 bits, so the normally
-- small length takes the form of 11.9.3.4 for n > 64 (a 1 bit, then an unconstrained length).
