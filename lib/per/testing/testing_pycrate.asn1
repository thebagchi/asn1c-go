Strings-P76 ::= VisibleString (FROM("a".."e",...))
Strings-P77 ::= BMPString (SIZE(0..5)) (FROM("abcdefghijklmnopqrstuvwxyz",...))
Strings-P78 ::= UniversalString (FROM("abcdefghijklmnopqrstuvwxyz",...))
Strings-P79 ::= IA5String (SIZE(1..4,...)) (FROM("a".."z",...))
Strings-P80 ::= IA5String (FROM("ab",...))
Strings-P81 ::= BMPString (FROM("ab",...))
Strings-P82 ::= PrintableString (FROM("ab",...))
Strings-P83 ::= BMPString (FROM("àéü中"))
Strings-P84 ::= BMPString (SIZE(3)) (FROM("àéü中"))
Strings-P85 ::= BMPString (FROM("àáâãä"))
Strings-P86 ::= BMPString (SIZE(3)) (FROM("àáâãä"))
Strings-P87 ::= UniversalString (FROM("😀😁😂"))
Strings-P88 ::= UniversalString (SIZE(3)) (FROM("😀😁😂"))
Strings-P89 ::= UniversalString (FROM("aé中😀􏿿"))
Strings-P90 ::= UniversalString (SIZE(3)) (FROM("aé中😀􏿿"))

END
